{
  "cleanupPeriodDays": 7,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "postman@local": true,
    "vercel@claude-plugins-official": true,
    "hyros-db@hyros-devops": true,
    "hyros-vpn@hyros-devops": true
  },
  "extraKnownMarketplaces": {
    "local": {
      "source": {
        "source": "directory",
        "path": "~/.claude/local-marketplace"
      }
    },
    "hyros-devops": {
      "source": {
        "source": "git",
        "url": "git@bitbucket.org:markethero/hyros-devops.git"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "diffSidebarOpen": false
}
